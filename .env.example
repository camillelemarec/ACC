# Le site signe les fichiers du bucket privé au moment du rendu.
# Ces secrets restent côté serveur. Ne pas préfixer par NEXT_PUBLIC_.
B2_MEDIA_ENABLED=false

# Secrets serveur uniquement. Ne pas préfixer par NEXT_PUBLIC_ :
# ces valeurs ne doivent jamais arriver dans le navigateur.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Durée de vie des URLs signées, en secondes.
B2_SIGNED_URL_TTL_SECONDS=3600

# Laisser vide : les objets sont à la racine du bucket, pas dans un dossier.
B2_KEY_PREFIX=
